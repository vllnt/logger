{
  "name": "@vllnt/logger",
  "version": "0.1.2",
  "type": "module",
  "description": "Structured logging for the @vllnt ecosystem",
  "license": "MIT",
  "author": "bntvllnt",
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/logger"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./convex": {
      "import": "./dist/convex.js",
      "types": "./dist/convex.d.ts"
    },
    "./posthog": {
      "import": "./dist/posthog.js",
      "types": "./dist/posthog.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vllnt/eslint-config": "^2.0.0",
    "@vllnt/typescript": "^2.0.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "handlebars@<4.7.10": "^4.7.10"
    }
  }
}
