{
  "name": "@vllnt/logger",
  "version": "0.1.3",
  "type": "module",
  "description": "Zero-dependency structured JSON logger for TypeScript with scoped events, log levels, timing, and console, PostHog and test outputs for Node.js and Convex.",
  "license": "MIT",
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "homepage": "https://oss.vllnt.com/packages/logger",
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/logger"
  },
  "bugs": {
    "url": "https://github.com/vllnt/logger/issues"
  },
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "json-logger",
    "log-levels",
    "typescript",
    "nodejs",
    "convex",
    "posthog",
    "zero-dependency",
    "esm"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./convex": {
      "types": "./dist/convex.d.ts",
      "import": "./dist/convex.js"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "import": "./dist/posthog.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs/API.md",
    "CHANGELOG.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit -p tsconfig.check.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/check-types.tsbuildinfo",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src --coverage.reporter=text",
    "test:package": "bash scripts/test-package.sh",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/eslint-config": "^2.1.0",
    "@vllnt/typescript": "^3.0.0",
    "eslint": "^9.39.5",
    "posthog-node": "^6.0.5",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@10.34.8",
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@>=7.0.0 <11.0.1": "11.0.5",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "handlebars@<4.7.10": "^4.7.10"
    }
  }
}
